{
  "name": "@sentry/decision-model-linter",
  "version": "0.2.0",
  "description": "Lint files with rules a decision model answers",
  "author": "Sentry",
  "license": "FSL-1.1-ALv2",
  "repository": "https://github.com/getsentry/decision-model-linter",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "decision-model-linter": "dist/cli.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "test": "node --test 'test/*.test.ts'",
    "typecheck": "tsc -p ."
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  }
}
